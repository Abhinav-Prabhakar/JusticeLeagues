{
  "name": "justice-leagues",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode pages",
    "publish:pages": "node scripts/publish-pages.mjs",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:api": "node scripts/reset-e2e-db.mjs && DB_PATH=./data/e2e.db PORT=8788 tsx server/index.ts",
    "e2e:web": "API_PORT=8788 vite --port 5174 --strictPort",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:reset": "tsx server/db/cli.ts reset",
    "db:backup": "tsx server/db/cli.ts backup",
    "db:restore": "tsx server/db/cli.ts restore",
    "ops:check": "tsx server/db/cli.ts check",
    "load": "node scripts/load-test.mjs",
    "vendor:assets": "node scripts/vendor-assets.mjs",
    "shots": "node scripts/screenshots.mjs",
    "shots:readme": "node scripts/readme-shots.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "2.1.1",
    "hono": "^4.13.16",
    "lucide-react": "^1.68.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.3.2",
    "vitest": "^5.1.0"
  }
}
